# EmailJS — envío de los formularios sin backend (sitio static export).
# Panel: https://dashboard.emailjs.com
#
# Copiá este archivo a .env.local y completá con tus valores reales:
#   cp .env.example .env.local
#
# Son claves PÚBLICAS (viajan en el bundle del navegador); aun así .env.local
# está gitignored. Si faltan, los formularios caen a "mailto:" sin romperse.
#
# La plantilla de EmailJS debe usar estas variables:
#   {{subject}}  {{from_name}}  {{reply_to}}  {{to_email}}  {{message}}
# y tener el "To Email" apuntando a tu casilla (neurasistemas@gmail.com).

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
