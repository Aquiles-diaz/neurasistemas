# EmailJS — claves para el envío de formularios (sin backend).
# Son públicas por diseño (viajan en el bundle), pero se cargan acá para no
# hardcodearlas y poder rotarlas. Copiá este archivo a .env.local y completá.
#
#   cp .env.example .env.local
#
# Sacás estos valores desde tu panel de EmailJS (https://dashboard.emailjs.com).
# Si faltan, los formularios caen automáticamente a un mailto: (no rompen).
# Acordate de cargarlas TAMBIÉN en Vercel → Settings → Environment Variables.

NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=
