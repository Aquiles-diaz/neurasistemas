# Variables de entorno del sitio. Todas son NEXT_PUBLIC_* porque el sitio es
# un export estático: viajan en el bundle del navegador (son públicas por
# diseño), pero se cargan acá para no hardcodearlas y poder rotarlas.
#
#   cp .env.example .env.local
#
# Cargalas TAMBIÉN donde se hace el build: Vercel → Settings → Environment
# Variables, o GitHub → Settings → Secrets (para el deploy a Firebase).

# ── EmailJS: envío de formularios sin backend (https://dashboard.emailjs.com)
# Si faltan, los formularios caen automáticamente a un mailto: (no rompen).
NEXT_PUBLIC_EMAILJS_SERVICE_ID=
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=

# ── Google Analytics 4: tráfico. ID de medición "G-XXXXXXXXXX"
# (Admin → Flujos de datos → Web). Sin valor, no se carga gtag.
NEXT_PUBLIC_GA_ID=

# ── Sentry: registro de errores del navegador. DSN del proyecto
# (Settings → Projects → Client Keys). Sin valor, no se carga el SDK.
NEXT_PUBLIC_SENTRY_DSN=

# ── Opcional: identificador de la versión desplegada, para agrupar errores en
# Sentry. En GitHub Actions se completa solo con el SHA del commit.
NEXT_PUBLIC_RELEASE=
